<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <!--
      macOS 本机 viewer：只用内置 UDP 传输，禁用 SHM。
      Linux 宿主机的 fastdds_profiles_host.xml 会挂 128MB SHM，在 macOS 上易导致
      FastDDS 线程死锁，表现为 Qt 界面卡住无响应。
    -->
    <participant profile_name="mac_participant" is_default_profile="true">
        <rtps>
            <useBuiltinTransports>true</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
