<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <!--
      宿主机通用：SHM + 内置 UDP。
      若要直接收 Docker 内 /camera/* 图像，请改用 fastdds_profiles_tele.xml
      （与容器 128MB SHM 一致），并运行:
        bash scripts/enable_host_ros2_camera.sh
      （开放 /dev/shm/fastrtps_* 权限；root 创建的段默认 644，宿主机加不进去）。
    -->
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>shm_transport</transport_id>
            <type>SHM</type>
            <segment_size>134217728</segment_size>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="host_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>shm_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>true</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
